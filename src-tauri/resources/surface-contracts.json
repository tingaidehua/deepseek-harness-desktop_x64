{
  "plugins": [
    "dsh-better-sidebar",
    "dsh-notification",
    "dshmarket",
    "dsh-tauri",
    "dsh-tauri-panel",
    "dsh-tauri-panel-extension",
    "dsh-tauri-rightclick",
    "dsh-tauri-session",
    "dsh-tauri-ui",
    "dsh-tauri-worktree"
  ],
  "resources": [
    { "id": "better-sidebar.terminal-bundle", "path": "/sidebar/bundle/terminal.js" },
    { "id": "better-sidebar.editor-bundle", "path": "/sidebar/bundle/editor.js" },
    { "id": "better-sidebar.mermaid-bundle", "path": "/sidebar/bundle/mermaid.js" }
  ],
  "visibleFailurePatterns": [
    "settings are unavailable in this browser",
    "failed to load plugins",
    "chunk script",
    "forbidden"
