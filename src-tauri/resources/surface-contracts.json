    { "id": "models", "labels": ["模型", "Models"], "expectedAny": ["DeepSeek", "添加提供方", "Add provider"] },
    { "id": "plugins", "labels": ["插件", "Plugins"], "expectedAny": ["Agent 循环", "Agent loop"] },
    { "id": "agent-presets", "labels": ["Agent 预设", "Agent presets"], "expectedAny": ["标准模式", "Standard"] },
    { "id": "plugin-market", "labels": ["插件市场", "Plugin market"], "expectedAny": ["插件市场", "Plugin market"] },
    { "id": "sidebar-cards", "labels": ["侧边卡片", "Sidebar cards"], "expectedAny": ["侧边卡片", "Sidebar cards"] },
    { "id": "archives", "labels": ["归档", "Archives"], "expectedAny": ["归档", "Archive"] }
  ],
  "sidebarTabs": [
    { "id": "files", "labels": ["Files", "文件"] },
    { "id": "terminal", "labels": ["终端", "Terminal"] },
    { "id": "source-control", "labels": ["源代码管理", "Source Control"] }
  ]
}
